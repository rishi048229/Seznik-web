# POS backend used by the System Health tab
# Local: http://localhost:5001/api
# Production EC2 example: http://18.215.253.75:5000/api
VITE_API_URL=http://localhost:5001/api
POS_API_URL=http://localhost:5001/api

# Admin login (defaults: SezAdmin / SeznikAdmin310!)
ADMIN_USER_ID=SezAdmin
ADMIN_PASSWORD=SeznikAdmin310!
ADMIN_SESSION_SECRET=change-me-in-production
