{
  "expo": {
    "name": "seznik-app",
    "slug": "seznik-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "seznikapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.rishi048229.seznikapp",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow Seznik POS to scan barcodes and the login QR from your dashboard.",
        "NSPhotoLibraryUsageDescription": "Allow Seznik POS to choose product photos from your gallery.",
        "NSPhotoLibraryAddUsageDescription": "Allow Seznik POS to save product photos to your library.",
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.rishi048229.seznikapp",
      "requestLegacyExternalStorage": true,
      "permissions": [
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Seznik POS to scan barcodes and the login QR from your dashboard.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Seznik POS to choose product photos from your gallery.",
          "cameraPermission": "Allow Seznik POS to take product photos."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A2E",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      "expo-secure-store",
      "expo-image",
      "expo-web-browser",
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow Seznik POS to access your contacts to import them as customers."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f680be5e-7598-45be-ac1c-e42a9be86704"
      }
    },
    "owner": "kyro-labs"
  }
}
