{
  "expo": {
    "name": "seznik-app",
    "slug": "seznik-app",
    "version": "1.0.1",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/fe03bcde-b899-40d9-96d8-a59892db22a3",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "seznikapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.rishi048229.seznikapp",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow Seznik POS to scan barcodes and the login QR from your dashboard.",
        "NSPhotoLibraryUsageDescription": "Allow Seznik POS to choose product photos from your gallery.",
        "NSPhotoLibraryAddUsageDescription": "Allow Seznik POS to save product photos to your library.",
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true
      }
    },
    "android": {
      "versionCode": 12,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.rishi048229.seznikapp",
      "permissions": [
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ],
      "usesCleartextTraffic": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-notifications",
      "expo-updates",
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Seznik POS to scan barcodes and the login QR from your dashboard.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Seznik POS to choose product photos from your gallery.",
          "cameraPermission": "Allow Seznik POS to take product photos."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A2E",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      "expo-secure-store",
      "expo-image",
      "expo-web-browser",
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow Seznik POS to access your contacts to import them as customers."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "extraMavenRepos": [
              "https://gitee.com/it_space/bluetooth-sdk/raw/master"
            ],
            "buildArchs": ["arm64-v8a"]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "productionApiUrl": "http://54.175.133.69:5001/api",
      "eas": {
        "projectId": "fe03bcde-b899-40d9-96d8-a59892db22a3"
      }
    },
    "owner": "rishi048229"
  }
}
