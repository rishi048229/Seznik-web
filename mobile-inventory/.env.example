# Seznik Mobile App Environment Configuration
# (All variables must start with EXPO_PUBLIC_ to be exposed to the React Native bundle)

# 1. Full API URL (Overrides everything if set)
# EXPO_PUBLIC_API_URL=http://192.168.0.11:5001/api

# 2. Backend Port (Default: 5001)
EXPO_PUBLIC_API_PORT=5001

# 3. Optional Explicit Backend Host IP (Auto-detected from Expo bundler if omitted)
# EXPO_PUBLIC_API_HOST=192.168.0.11
