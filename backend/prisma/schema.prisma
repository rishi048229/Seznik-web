generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String    @id @default(uuid())
  uid                 String    @unique // For migrating from firebase if needed
  email               String?   @unique
  emailVerified       Boolean   @default(false)
  phone               String? // nullable for pre-existing rows; required at registration
  password            String?
  displayName         String?
  photoURL            String?   @db.Text
  businessName        String?
  plan                String    @default("free")
  onboardingCompleted Boolean   @default(false)
  role                String?
  // Belongs to the "dev" branch (see the CreditReminder/DayClose comment
  // further down) — restored so `db push` doesn't drop real data.
  isBanned            Boolean   @default(false)
  banReason           String?
  bannedAt            DateTime?
  permissions         Json?

  // Relations for managed users (if needed in backend, otherwise stored as JSON)
  // To keep it 1:1 with Firestore subcollections, we can create a separate ManagedUser model
  managedUsers          ManagedUser[]
  categories            Category[]
  settings              Settings?
  customers             Customer[]
  suppliers             Supplier[]
  products              Product[]
  stockHistory          StockHistory[]
  sales                 Sale[]
  purchases             Purchase[]
  expenses              Expense[]
  creditTransactions    CreditTransaction[]
  feedbacks             Feedback[]
  tokenTypes            TokenType[]
  tokens                Token[]
  locations             Location[]
  productLocationStocks ProductLocationStock[]
  stockTransfers        StockTransfer[]
  // Belong to the "dev" branch's KOT/restaurant-table feature — its schema was
  // never merged into main, but `prisma db push` had already been run against
  // this same local database from that branch at some point, so these tables
  // exist here with real rows. Restored (not dropped) so `db push` stays
  // additive-only; see the models themselves further down for detail.
  creditReminders       CreditReminder[]
  dayCloses             DayClose[]
  restaurantTables      RestaurantTable[]
  kotOrders             KOTOrder[]
  kotOrderItems         KOTOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One pending email-verification OTP per email address (pre-signup).
model EmailOtp {
  id         String    @id @default(uuid())
  email      String    @unique
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model ManagedUser {
  id           String  @id @default(uuid())
  uid          String  @unique
  displayName  String?
  email        String?
  password     String?
  role         String?
  permissions  Json?
  photoURL     String?
  businessName String?
  plan         String  @default("free")

  adminId String
  admin   User   @relation(fields: [adminId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id        String     @id @default(uuid())
  name      String
  isActive  Boolean    @default(true)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  products  Product[]
  // Self-relation for a single level of subcategories (e.g. "Shirts" -> "Checks", "Plain").
  // parent is nullable: null means this is a top-level category. Deleting a parent cascades
  // to its subcategories (a subcategory can't meaningfully outlive its parent).
  parentId  String?
  parent    Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children  Category[] @relation("CategoryHierarchy")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([parentId])
}

model Settings {
  id                 String   @id @default(uuid())
  businessName       String?
  businessAddress    String?
  businessPhone      String?
  businessGSTIN      String?
  businessLogoURL    String?  @db.Text
  personalInfo       Json?
  invoiceConfig      Json?
  notificationConfig Json?
  receiptConfig      Json?
  printerConfig      Json?
  // Belongs to the "dev" branch (see User model comment above) — restored so
  // `db push` doesn't drop the real row this database already has.
  labelConfig        Json?
  // Multi-location inventory feature flag: { enabled: boolean }.
  locationConfig     Json?
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Customer {
  id                 String              @id @default(uuid())
  name               String
  phone              String
  email              String?
  address            String?
  creditBalance      Float               @default(0)
  creditLimit        Float               @default(0)
  // Belongs to the "dev" branch (see User model comment above) — restored so
  // `db push` doesn't drop the real row this database already has.
  oldestUnpaidSince  DateTime?
  userId             String
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  sales              Sale[]
  creditTransactions CreditTransaction[]
  creditReminders    CreditReminder[]
  kotOrders          KOTOrder[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model Supplier {
  id        String     @id @default(uuid())
  name      String
  phone     String
  email     String?
  address   String?
  gstin     String?
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  products  Product[]
  purchases Purchase[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Product {
  id                String    @id @default(uuid())
  name              String
  sku               String
  barcode           String?
  // Which symbology the barcode uses (CODE128 / EAN13 / QR) so label printing
  // renders it correctly for this specific product.
  barcodeType       String    @default("CODE128")
  categoryId        String
  category          Category  @relation(fields: [categoryId], references: [id])
  supplierId        String?
  supplier          Supplier? @relation(fields: [supplierId], references: [id])
  imageURL          String?   @db.Text
  costPrice         Float     @default(0)
  sellingPrice      Float     @default(0)
  taxRate           Float     @default(0)
  priceIncludesGst  Boolean   @default(false)
  currentStock      Float     @default(0)
  lowStockThreshold Float     @default(0)
  unit              String    @default("piece")
  isActive          Boolean   @default(true)

  // Optional details — never required at creation, purely informational.
  brand       String?
  description String?   @db.Text
  expiryDate  DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  stockHistory   StockHistory[]
  locationStocks ProductLocationStock[]
  stockTransfers StockTransfer[]
  // Belongs to the "dev" branch (see User model comment above).
  kotOrderItems  KOTOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StockHistory {
  id         String    @id @default(uuid())
  change     Float
  reason     String
  barcode    String?
  productId  String
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Set only when the change happened against a specific location's stock
  // pool (multi-location inventory) rather than the product's flat total.
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
}

// A physical place stock can sit — a warehouse, a shop branch, etc. Purely
// opt-in: Settings.locationConfig.enabled gates whether any of this is shown
// in the UI. A product with no matching ProductLocationStock row at the
// selected location is treated as 0 available there (not falling back to
// Product.currentStock) — that's what makes stock genuinely per-location.
model Location {
  id           String                 @id @default(uuid())
  name         String
  isActive     Boolean                @default(true)
  sortOrder    Int                    @default(0)
  userId       String
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  stocks       ProductLocationStock[]
  stockHistory StockHistory[]
  transfersOut StockTransfer[]        @relation("TransferFrom")
  transfersIn  StockTransfer[]        @relation("TransferTo")
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
}

// One row per (product, location): that location's stock count and an
// optional price override (null = use Product.sellingPrice). This is the
// join table that makes "sell from Warehouse vs Shop" mean something.
model ProductLocationStock {
  id                String   @id @default(uuid())
  productId         String
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  locationId        String
  location          Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  stock             Float    @default(0)
  priceOverride     Float?
  lowStockThreshold Float?
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([productId, locationId])
}

// A manual stock move between two locations for the same product.
model StockTransfer {
  id             String   @id @default(uuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  fromLocationId String
  fromLocation   Location @relation("TransferFrom", fields: [fromLocationId], references: [id])
  toLocationId   String
  toLocation     Location @relation("TransferTo", fields: [toLocationId], references: [id])
  quantity       Float
  note           String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
}

model Sale {
  id             String    @id @default(uuid())
  invoiceNumber  String
  customerId     String?
  customer       Customer? @relation(fields: [customerId], references: [id])
  items          Json
  subtotal       Float
  totalDiscount  Float
  totalTax       Float
  grandTotal     Float
  paymentMethod  String
  amountPaid     Float
  changeReturned Float
  isQuickBill    Boolean   @default(false)
  // Which location this whole sale was billed from (multi-location inventory
  // feature) — null when the feature is off or the location wasn't selected.
  locationId     String?
  // Belongs to the "dev" branch — restored so `db push` doesn't drop real data.
  platform       String    @default("web")
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token          Token?
  // Belongs to the "dev" branch (see User model comment above).
  kotOrder       KOTOrder?
  createdAt      DateTime  @default(now())
}

model Purchase {
  id            String    @id @default(uuid())
  invoiceNumber String
  supplierId    String?
  supplier      Supplier? @relation(fields: [supplierId], references: [id])
  items         Json
  subtotal      Float
  totalTax      Float
  grandTotal    Float
  paymentMethod String
  amountPaid    Float
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
}

model Expense {
  id              String   @id @default(uuid())
  amount          Float
  category        String
  description     String?
  paymentMethod   String   @default("cash")
  receiptImageURL String?  @db.Text
  expenseDate     DateTime
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
}

model CreditTransaction {
  id          String   @id @default(uuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  amount      Float
  type        String
  referenceId String?
  notes       String?
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

model Feedback {
  id        String   @id @default(uuid())
  // What part of the app the feedback is about (e.g. "pos", "products", "general").
  area      String   @default("general")
  // 1-5 star rating; optional so pure text feedback is also valid.
  rating    Int?
  message   String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

// A user-defined quick-bill item (e.g. "Chai Token", "Samosa Token", "Parking").
// price is nullable — a fixed-price type issues instantly, a null-price type
// (parking, QR bill) prompts for the amount at issue time.
model TokenType {
  id        String   @id @default(uuid())
  name      String
  price     Float?
  taxRate   Float    @default(0)
  // Keys into a fixed frontend icon/color palette (e.g. "coffee" / "amber") — not free text.
  icon      String   @default("ticket")
  color     String   @default("blue")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokens    Token[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Wraps an issued token's Sale record with a per-day sequential ticket number
// (resets daily) so the printed slip reads "Token #14" instead of an invoice number.
model Token {
  id          String     @id @default(uuid())
  tokenNumber Int
  note        String?
  tokenTypeId String?
  tokenType   TokenType? @relation(fields: [tokenTypeId], references: [id], onDelete: SetNull)
  saleId      String     @unique
  sale        Sale       @relation(fields: [saleId], references: [id], onDelete: Cascade)
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
}

// ─── Restored from the "dev" branch (see User model comment above) ────────
// These 5 models + Customer.oldestUnpaidSince + Settings.labelConfig were
// never part of main's schema.prisma, but this local database already has
// real rows for them (created by `prisma db push` having been run here at
// some point from the dev branch). Restoring them keeps `db push` additive
// -only instead of dropping that data. No controllers/routes on main
// currently read or write these — they are schema-only until/unless the KOT
// feature itself is ported over.

model CreditReminder {
  id         String   @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  amount     Float
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sentAt     DateTime @default(now())
}

model DayClose {
  id           String   @id @default(uuid())
  closeDate    DateTime @db.Date
  expectedCash Float
  countedCash  Float
  variance     Float
  notes        String?
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@unique([userId, closeDate])
}

model RestaurantTable {
  id        String     @id @default(uuid())
  name      String
  isActive  Boolean    @default(true)
  sortOrder Int        @default(0)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders    KOTOrder[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model KOTOrder {
  id              String           @id @default(uuid())
  orderNumber     Int
  orderType       String           @default("dine_in") // 'dine_in' | 'takeaway' | 'delivery'
  tableId         String?
  table           RestaurantTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  partyLabel      String?
  guestCount      Int?
  customerId      String?
  customer        Customer?        @relation(fields: [customerId], references: [id])
  status          String           @default("open")
  notes           String?
  priority        String           @default("normal")
  contactNumber   String?
  sentToKitchenAt DateTime?
  saleId          String?          @unique
  sale            Sale?            @relation(fields: [saleId], references: [id], onDelete: SetNull)
  items           KOTOrderItem[]
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([userId, status])
  @@index([tableId])
}

model KOTOrderItem {
  id          String   @id @default(uuid())
  orderId     String
  order       KOTOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  quantity    Float
  unitPrice   Float
  taxRate     Float
  notes       String?
  modifiers   String[] @default([])
  status      String   @default("pending")
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
