generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String  @id @default(uuid())
  uid                 String  @unique // For migrating from firebase if needed
  email               String? @unique
  emailVerified       Boolean @default(false)
  phone               String? // nullable for pre-existing rows; required at registration
  password            String?
  displayName         String?
  photoURL            String? @db.Text
  businessName        String?
  businessType        String? // restaurant_cafe | online_store | retail_shop
  plan                String  @default("free")
  onboardingCompleted Boolean @default(false)
  role                String?
  permissions         Json?

  isBanned  Boolean   @default(false)
  banReason String?
  bannedAt  DateTime?
  seznikUser Boolean  @default(false)

  // Relations for managed users (if needed in backend, otherwise stored as JSON)
  // To keep it 1:1 with Firestore subcollections, we can create a separate ManagedUser model
  managedUsers          ManagedUser[]
  categories            Category[]
  settings              Settings?
  customers             Customer[]
  suppliers             Supplier[]
  products              Product[]
  stockHistory          StockHistory[]
  sales                 Sale[]
  purchases             Purchase[]
  expenses              Expense[]
  creditTransactions    CreditTransaction[]
  feedbacks             Feedback[]
  tokenTypes            TokenType[]
  tokens                Token[]
  creditReminders       CreditReminder[]
  dayCloses             DayClose[]
  restaurantTables      RestaurantTable[]
  kotOrders             KOTOrder[]
  kotOrderItems         KOTOrderItem[]
  kotPrintEvents        KOTPrintEvent[]
  locations             Location[]
  productLocationStocks ProductLocationStock[]
  stockTransfers        StockTransfer[]
  utilityBills          UtilityBill[]
  printerLogs           PrinterLog[]
  saleReturns           SaleReturn[]
  saleExchanges         SaleExchange[]
  purchaseReturns       PurchaseReturn[]
  supplierTransactions  SupplierTransaction[]
  deviceTokens          DeviceToken[]
  printJobs             PrintJob[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One pending email-verification OTP per email address (pre-signup).
model EmailOtp {
  id         String    @id @default(uuid())
  email      String    @unique
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

// Short-lived, one-time code shown as a QR on the web dashboard so the
// mobile app can sign in as the same account without typing a password.
// userId is not a FK: it may point at User or ManagedUser (see accountType).
model QrLoginSession {
  id          String    @id @default(uuid())
  tokenHash   String    @unique
  userId      String
  accountType String
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model ManagedUser {
  id           String  @id @default(uuid())
  uid          String  @unique
  displayName  String?
  email        String?
  password     String?
  role         String?
  permissions  Json?
  photoURL     String?
  businessName String?
  plan         String  @default("free")

  adminId String
  admin   User   @relation(fields: [adminId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id        String     @id @default(uuid())
  name      String
  isActive  Boolean    @default(true)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  products  Product[]
  // Self-relation for a single level of subcategories (e.g. "Shirts" -> "Checks", "Plain").
  // parent is nullable: null means this is a top-level category. Deleting a parent cascades
  // to its subcategories (a subcategory can't meaningfully outlive its parent).
  parentId  String?
  parent    Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children  Category[] @relation("CategoryHierarchy")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([parentId])
}

model Settings {
  id                 String   @id @default(uuid())
  businessName       String?
  businessAddress    String?
  businessPhone      String?
  businessGSTIN      String?
  businessLogoURL    String?  @db.Text
  personalInfo       Json?
  invoiceConfig      Json?
  notificationConfig Json?
  receiptConfig      Json?
  printerConfig      Json?
  locationConfig     Json?
  kotConfig          Json?
  // Merchant UPI VPA (e.g. shop@okhdfcbank). Required when a receipt QR is UPI.
  upiId              String?
  labelConfig        Json?
  /// When false (restaurants/cafes), inventory quantity is not tracked — only Product.isAvailable.
  trackStock         Boolean  @default(true)
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Customer {
  id                 String              @id @default(uuid())
  name               String
  phone              String
  email              String?
  address            String?
  creditBalance      Float               @default(0)
  creditLimit        Float               @default(0)
  // Pre-existing column not previously tracked in this file (restored from live DB
  // introspection so `db push` stays additive-only and never proposes dropping real data).
  oldestUnpaidSince  DateTime?
  userId             String
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  sales              Sale[]
  creditTransactions CreditTransaction[]
  creditReminders    CreditReminder[]
  kotOrders          KOTOrder[]
  saleReturns        SaleReturn[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([userId])
  @@index([userId, creditBalance])
}

model Supplier {
  id                 String                @id @default(uuid())
  name               String
  phone              String
  email              String?
  address            String?
  gstin              String?
  payableBalance     Float                 @default(0)
  userId             String
  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  products           Product[]
  purchases          Purchase[]
  purchaseReturns    PurchaseReturn[]
  transactions       SupplierTransaction[]
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([userId])
  @@index([userId, payableBalance])
}

model Product {
  id                String    @id @default(uuid())
  name              String
  sku               String
  barcode           String?
  barcodeType       String    @default("CODE128")
  categoryId        String
  category          Category  @relation(fields: [categoryId], references: [id])
  supplierId        String?
  supplier          Supplier? @relation(fields: [supplierId], references: [id])
  imageURL          String?   @db.Text
  costPrice         Float     @default(0)
  sellingPrice      Float     @default(0)
  taxRate           Float     @default(0)
  priceIncludesGst  Boolean   @default(false)
  currentStock      Float     @default(0)
  lowStockThreshold Float     @default(0)
  unit              String    @default("piece")
  isActive          Boolean   @default(true)
  isAvailable       Boolean   @default(true)

  // Per-product default discount the mobile POS applies when the item is added to a cart.
  // Nullable: most products have no standing discount.
  discountType      String?   // 'flat' | 'percent'
  discountValue     Float?

  brand       String?
  description String?   @db.Text
  expiryDate  DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  stockHistory   StockHistory[]
  kotOrderItems  KOTOrderItem[]
  locationStocks ProductLocationStock[]
  stockTransfers StockTransfer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, isActive])
  @@index([userId, isAvailable])
  @@index([userId, createdAt(sort: Desc)])
}

model StockHistory {
  id         String    @id @default(uuid())
  change     Float
  reason     String
  barcode    String?
  productId  String
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([productId, createdAt])
}

model Sale {
  id             String    @id @default(uuid())
  invoiceNumber  String
  customerId     String?
  customer       Customer? @relation(fields: [customerId], references: [id])
  items          Json
  subtotal       Float
  totalDiscount  Float
  totalTax       Float
  grandTotal     Float
  billCharges       Json?
  extraChargesTotal Float     @default(0)
  paymentMethod  String
  amountPaid     Float
  changeReturned Float
  isQuickBill    Boolean   @default(false)
  locationId     String?
  platform       String    @default("web")
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token          Token?
  kotOrder       KOTOrder?
  returnStatus   String    @default("none") // 'none' | 'partial' | 'full'
  totalRefunded  Float     @default(0)
  returns        SaleReturn[]
  exchangesAsOriginal SaleExchange[] @relation("OriginalSaleExchanges")
  exchangeAsNew      SaleExchange?  @relation("NewSaleExchange")
  
  orderType             String    @default("walk_in") // 'walk_in' | 'delivery'
  deliveryAddress       String?
  deliveryPhone         String?
  deliveryNotes         String?
  scheduledDeliveryDate DateTime?
  deliveryStatus        String    @default("delivered") // 'pending' | 'out_for_delivery' | 'delivered' | 'cancelled'
  deliveredAt           DateTime?
  paymentStatus         String    @default("paid") // 'paid' | 'pending' | 'partial'
  paymentDueDate        DateTime?

  // Set true the first time any PrintJob against this sale reaches 'completed'. A simple,
  // permanent "this receipt was fulfilled via remote printing at least once" flag for the Sales
  // page / Daybook badge — deliberately not trying to track every reprint's own state here;
  // printJobs below has the full history if that's ever needed.
  isRemotePrint         Boolean   @default(false)
  lastRemotePrintJobId  String?
  printJobs             PrintJob[]

  // Creator segregation (Admin vs Staff Agent vs Remote)
  createdById           String?
  createdByName         String?
  createdByRole         String?   // 'admin' | 'agent'

  status          String    @default("completed") // completed | cancelled
  cancelReason    String?
  cancelledAt     DateTime?
  cancelledByName String?

  createdAt      DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([userId, customerId])
  @@index([userId, orderType, deliveryStatus])
  @@index([userId, paymentStatus])
  @@index([userId, isRemotePrint])
  @@index([userId, createdByRole])
}

model Location {
  id           String                 @id @default(uuid())
  name         String
  isActive     Boolean                @default(true)
  sortOrder    Int                    @default(0)
  userId       String
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  stocks       ProductLocationStock[]
  stockHistory StockHistory[]
  transfersOut StockTransfer[]        @relation("TransferFrom")
  transfersIn  StockTransfer[]        @relation("TransferTo")
  kotOrders    KOTOrder[]
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
}

model ProductLocationStock {
  id                String   @id @default(uuid())
  productId         String
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  locationId        String
  location          Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  stock             Float    @default(0)
  priceOverride     Float?
  lowStockThreshold Float?
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([productId, locationId])
}

model StockTransfer {
  id             String   @id @default(uuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  fromLocationId String
  fromLocation   Location @relation("TransferFrom", fields: [fromLocationId], references: [id])
  toLocationId   String
  toLocation     Location @relation("TransferTo", fields: [toLocationId], references: [id])
  quantity       Float
  note           String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
}

model Purchase {
  id                 String           @id @default(uuid())
  invoiceNumber      String
  supplierBillNumber String?
  supplierId         String?
  supplier           Supplier?        @relation(fields: [supplierId], references: [id])
  items              Json
  subtotal           Float
  totalTax           Float
  grandTotal         Float
  paymentMethod      String           @default("cash") // 'cash' | 'bank' | 'upi' | 'credit'
  paymentStatus      String           @default("paid") // 'paid' | 'partial' | 'pending'
  amountPaid         Float            @default(0)
  paymentDueDate     DateTime?
  notes              String?
  returnStatus       String           @default("none") // 'none' | 'partial' | 'full'
  totalReturned      Float            @default(0)
  returns            PurchaseReturn[]
  userId             String
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt          DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([userId, paymentStatus])
  @@index([userId, supplierId])
}

model SupplierTransaction {
  id            String    @id @default(uuid())
  supplierId    String
  supplier      Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  amount        Float
  type          String    // 'purchase' | 'payment' | 'debit_note_reversal'
  paymentMethod String?   // 'cash' | 'bank' | 'upi' | 'cheque' | 'credit'
  referenceId   String?   // purchaseId or purchaseReturnId
  notes         String?
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())

  @@index([userId])
  @@index([supplierId, createdAt])
}

model Expense {
  id              String   @id @default(uuid())
  amount          Float
  category        String
  description     String?
  paymentMethod   String   @default("cash")
  receiptImageURL String?  @db.Text
  expenseDate     DateTime
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())

  @@index([userId, expenseDate])
}

model CreditTransaction {
  id          String   @id @default(uuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  amount      Float
  type        String
  referenceId String?
  notes       String?
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([customerId, createdAt])
}

model Feedback {
  id          String   @id @default(uuid())
  // What part of the app the feedback is about (e.g. "pos", "products", "general").
  area        String   @default("general")
  // 1-5 star rating; optional so pure text feedback is also valid.
  rating      Int?
  message     String
  platform    String   @default("unknown") // web | mobile | unknown (legacy)
  productId   String   @default("general")
  productName String   @default("Unknown")
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([productId])
}

// Pre-existing model not previously tracked in this file (restored from live DB
// introspection — no current backend route writes to it; `getRemindersDue`/`logReminderSent`
// in creditController.ts compute reminders in-memory rather than persisting here, so this
// table is effectively dormant, but it holds real historical rows and is left untouched).
model CreditReminder {
  id         String   @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  amount     Float
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sentAt     DateTime @default(now())
}

// Pre-existing model not previously tracked in this file (restored from live DB
// introspection). The frontend Daybook screen (mobile-inventory/src/app/credits.tsx) calls
// GET/POST /api/reports/day-close for this, but no such route exists in reportRoutes.ts today
// — that's a separate, pre-existing bug outside this change's scope, not something fixed here.
model DayClose {
  id           String   @id @default(uuid())
  closeDate    DateTime @db.Date
  expectedCash Float
  countedCash  Float
  variance     Float
  notes        String?
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@unique([userId, closeDate])
}

// A user-defined quick-bill item (e.g. "Chai Token", "Samosa Token", "Parking").
// price is nullable — a fixed-price type issues instantly, a null-price type
// (parking, QR bill) prompts for the amount at issue time.
model TokenType {
  id        String   @id @default(uuid())
  name      String
  price     Float?
  taxRate   Float    @default(0)
  // Keys into a fixed frontend icon/color palette (e.g. "coffee" / "amber") — not free text.
  icon      String   @default("ticket")
  color     String   @default("blue")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokens    Token[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Wraps an issued token's Sale record with a per-day sequential ticket number
// (resets daily) so the printed slip reads "Token #14" instead of an invoice number.
model Token {
  id          String     @id @default(uuid())
  tokenNumber Int
  note        String?
  tokenTypeId String?
  tokenType   TokenType? @relation(fields: [tokenTypeId], references: [id], onDelete: SetNull)
  saleId      String     @unique
  sale        Sale       @relation(fields: [saleId], references: [id], onDelete: Cascade)
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
}

// ─── KOT & Restaurant Orders (Phase 1) ─────────────────────────────────────

// Flat list of dine-in tables for Phase 1. Deliberately has no position/shape/
// capacity columns yet — a future floor-plan UI can add those as additive
// nullable columns via `npx prisma db push` with zero impact on existing rows
// or on KOTOrder, since it only references this model's id.
model RestaurantTable {
  id        String     @id @default(uuid())
  name      String
  capacity  Int?
  isActive  Boolean    @default(true)
  sortOrder Int        @default(0)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders    KOTOrder[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

// A dine-in/takeaway/delivery order moving through the kitchen. Items are a
// live child relation (not a JSON blob like Sale.items) so they can be added
// or removed while the order is still open — totals are computed on read and
// only crystallized into a real Sale's columns once the bill is generated.
model KOTOrder {
  id              String           @id @default(uuid())
  // Per-day sequential ticket number, resets daily. Mirrors Token.tokenNumber.
  orderNumber     Int
  orderType       String           @default("dine_in") // 'dine_in' | 'takeaway' | 'delivery'
  tableId         String?
  // SetNull, not Cascade: deleting/deactivating a table config must never destroy order history.
  table           RestaurantTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  // Free-text identifier for takeaway/delivery orders, or a supplemental note alongside a table.
  partyLabel      String?
  guestCount      Int?
  customerId      String?
  customer        Customer?        @relation(fields: [customerId], references: [id])
  // open -> sent_to_kitchen -> preparing -> ready -> served -> billed, or cancelled from any
  // non-terminal state. 'billed' is only ever set by the /bill endpoint, never generic status updates.
  status          String           @default("open")
  notes           String?
  // 'normal' | 'urgent' — surfaced on the orders board and printed as a banner on the KOT ticket.
  priority        String           @default("normal")
  // Phone number for takeaway/delivery orders — separate from an attached Customer record,
  // which stays optional (most takeaway/delivery orders never need a full customer profile).
  contactNumber   String?
  waiterName      String?
  locationId      String?
  location        Location?        @relation(fields: [locationId], references: [id], onDelete: SetNull)
  sentToKitchenAt DateTime?
  cancelledAt     DateTime?
  cancelReason    String?
  cancelledByName String?
  // Set once billed. SetNull (not Cascade): the order predates and outlives the sale it produces.
  saleId          String?          @unique
  sale            Sale?            @relation(fields: [saleId], references: [id], onDelete: SetNull)
  items           KOTOrderItem[]
  printEvents     KOTPrintEvent[]
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([userId, status])
  @@index([tableId])
}

model KOTOrderItem {
  id          String   @id @default(uuid())
  orderId     String
  order       KOTOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  // SetNull + productName snapshot: order history survives product deletion, same reasoning as
  // Sale.items JSON already snapshotting productName instead of always joining the live row.
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  quantity    Float
  unitPrice   Float // snapshot of Product.sellingPrice at add-time
  taxRate     Float // snapshot of Product.taxRate at add-time
  notes       String? // free-text note, e.g. "extra crispy please"
  // Quick-pick add-on/modifier tags, e.g. ["No Onion", "Extra Spicy"] — separate from the
  // free-text notes field above so the kitchen ticket can print them as a distinct tag list.
  modifiers   String[] @default([])
  status      String   @default("pending")
  sentToKitchenAt DateTime?
  kotBatchNumber Int?
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orderId])
}

/// Restaurant kitchen stock. Separate from Product inventory used by retail.
model KitchenIngredient {
  id                String   @id @default(uuid())
  userId            String
  name              String
  unit              String   @default("g")
  currentStock      Float    @default(0)
  lowStockThreshold Float    @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
}

model RecipeLine {
  id           String @id @default(uuid())
  userId       String
  productId    String
  ingredientId String
  quantity     Float

  @@index([userId, productId])
  @@index([ingredientId])
}

model WastageLog {
  id           String   @id @default(uuid())
  userId       String
  ingredientId String
  quantity     Float
  reason       String?
  createdAt    DateTime @default(now())

  @@index([userId])
}

model KitchenPurchase {
  id           String   @id @default(uuid())
  userId       String
  ingredientId String
  quantity     Float
  supplierName String?
  createdAt    DateTime @default(now())

  @@index([userId])
}

/// Admin-generated unique alphanumeric access codes (7 chars) for distribution / redemption.
model AccessCode {
  id             String    @id @default(uuid())
  code           String    @unique @db.VarChar(7)
  batchId        String
  note           String?
  createdBy      String?
  createdAt      DateTime  @default(now())
  customerName   String?
  customerId     String?
  invoiceNumber  String?
  phone          String?
  printer        String?
  isUsed         Boolean   @default(false)
  usedAt         DateTime?
  usedByUserId   String?
  customerEmail  String?

  @@index([batchId])
  @@index([createdAt])
  @@index([createdBy])
  @@index([isUsed])
  @@index([usedByUserId])
  @@index([invoiceNumber])
}

/// Customer-support portal agents managed from the admin Support Access page.
model SupportAgent {
  id           String    @id @default(uuid())
  name         String
  phone        String
  email        String    @unique
  username     String    @unique
  passwordHash String
  isDisabled   Boolean   @default(false)
  createdBy    String?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([isDisabled])
}

/// Hourly aggregated API usage for admin analytics (feature × route × method × businessType).
model ApiUsageBucket {
  id           String   @id @default(uuid())
  bucketStart  DateTime // floored to hour UTC
  featureKey   String
  routePrefix  String
  method       String
  businessType String // restaurant_cafe | online_store | retail_shop | unknown
  callCount    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([bucketStart, featureKey, routePrefix, method, businessType])
  @@index([bucketStart])
  @@index([businessType, bucketStart])
  @@index([featureKey, bucketStart])
}

/// Utility bills converted to thermal payment receipts (A4 to Receipt feature).
model UtilityBill {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  receiptNumber  String?
  kioskName      String?  @default("SEZNIK KIOSK")
  billType       String   @default("Electricity") // Electricity | Water | Gas | Telecom | Other
  provider       String?
  consumerNumber String?
  consumerName   String?
  dueDate        String?
  billDate       String?
  unitsConsumed  String?
  billAmount     Float    @default(0)
  convenienceFee Float    @default(0)
  totalAmount    Float    @default(0)
  totalReceived  Float    @default(0)
  status         String   @default("SUCCESS (PAID)")
  paymentMode    String?  @default("CASH")
  customerPhone  String?
  operatorName   String?
  date           DateTime @default(now())
  rawText        String?  @db.Text
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@index([userId, date])
  @@index([consumerNumber])
  @@index([receiptNumber])
}

/// Logs of printer connections (exact bluetooth device names) from Web and Mobile apps.
model PrinterLog {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  printerName    String   // Exact Bluetooth name as reported by the device
  deviceAddress  String?  // MAC address or Web BLE device UUID
  platform       String   @default("web") // 'web' | 'mobile'
  connectionType String?  @default("bluetooth") // 'bluetooth' | 'ble'
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([printerName])
  @@index([createdAt])
  @@index([platform])
}

/// Customer return / credit note records linked to a prior Sale invoice.
model SaleReturn {
  id                   String    @id @default(uuid())
  returnNumber         String    // e.g. "CN-00001" or "RET-00001"
  saleId               String
  sale                 Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  customerId           String?
  customer             Customer? @relation(fields: [customerId], references: [id])
  items                Json      // [{ productId, productName, quantity, unitPrice, taxRate, taxableAmount, gstAmount, refundAmount, restock }]
  subtotal             Float     // Taxable value uncollected (returnsDeducted)
  totalTax             Float     // GST tax uncollected (returnsTaxDeducted)
  extraChargesRefunded Float     @default(0)
  refundAmount         Float     // Total cash/credit returned to customer
  refundMethod         String    // 'cash' | 'upi' | 'card' | 'store_credit' | 'credit_reversal'
  reason               String?   // 'defective' | 'customer_changed_mind' | 'wrong_item' | 'other'
  notes                String?
  locationId           String?
  platform             String    @default("web") // 'web' | 'mobile'
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  exchange             SaleExchange?
  createdAt            DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([saleId])
  @@index([customerId])
}

/// Product replacement / exchange transaction linking an inward return leg and an outward new sale leg.
model SaleExchange {
  id               String      @id @default(uuid())
  exchangeNumber   String      // e.g. "EXC-00001"
  originalSaleId   String
  originalSale     Sale        @relation("OriginalSaleExchanges", fields: [originalSaleId], references: [id], onDelete: Cascade)
  saleReturnId     String      @unique
  saleReturn       SaleReturn  @relation(fields: [saleReturnId], references: [id], onDelete: Cascade)
  newSaleId        String      @unique
  newSale          Sale        @relation("NewSaleExchange", fields: [newSaleId], references: [id], onDelete: Cascade)
  differenceAmount Float       // newSale.grandTotal - saleReturn.refundAmount (>0 customer pays, <0 store refunds, ==0 even)
  exchangeDiscount Float       @default(0) // Explicit merchant goodwill / exchange adjustment discount
  settlementMethod String      // 'even_exchange' | 'cash' | 'upi' | 'card' | 'store_credit' | 'credit_ledger'
  reason           String?     // 'defective' | 'size_fit_change' | 'customer_preference' | 'wrong_item' | 'other'
  notes            String?
  platform         String      @default("web") // 'web' | 'mobile'
  userId           String
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime    @default(now())

  @@index([userId, createdAt])
  @@index([originalSaleId])
  @@index([userId, originalSaleId])
}

/// Supplier return / debit note records linked to a prior Purchase invoice.
model PurchaseReturn {
  id               String    @id @default(uuid())
  returnNumber     String    // e.g. "DN-00001" or "PR-00001" (Debit Note)
  purchaseId       String
  purchase         Purchase  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  supplierId       String?
  supplier         Supplier? @relation(fields: [supplierId], references: [id])
  items            Json      // [{ productId, productName, quantity, unitCost, taxRate, taxableAmount, gstAmount, refundAmount }]
  subtotal         Float     // Taxable value reversed
  totalTax         Float     // ITC amount reversed
  refundAmount     Float     // Total debit / refund amount credited back from supplier
  settlementMethod String    // 'cash' | 'bank_transfer' | 'adjust_against_payable' | 'supplier_credit'
  reason           String?   // 'damaged' | 'wrong_item' | 'quality_reject' | 'excess_stock' | 'other'
  notes            String?
  locationId       String?
  platform         String    @default("web") // 'web' | 'mobile'
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([purchaseId])
  @@index([supplierId])
}

/// One row per logged-in device/person that can receive a push notification — deliberately
/// separate from Settings.notificationConfig.pushTokens, which is ONE shared pool per business
/// (max 5 tokens, no distinction between the owner and any staff/ManagedUser login) and was never
/// built to target a specific person. Settings.userId also has a strict FK to User, so a
/// ManagedUser (the model real field agents already use) registering a token there hits a foreign
/// key violation today. This table is additive: existing broadcast-style pushes (low stock, credit
/// due, etc.) keep using Settings untouched; only remote-print targeting uses this.
model DeviceToken {
  id                 String   @id @default(uuid())
  ownerUserId        String   // business scope (getOwnerUserId) — lets the owner list "all agent devices at this business"
  owner              User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  actorId            String   // raw JWT subject id — a User.id (owner) or a ManagedUser.id (agent/staff), whichever actually owns this device
  actorName          String   // snapshotted display name, so history/UI reads correctly even if the account is later renamed
  actorIsManagedUser Boolean  @default(false)
  expoPushToken      String   @unique
  platform           String   @default("android") // 'android' | 'ios'
  lastSeenAt         DateTime @default(now())
  createdAt          DateTime @default(now())

  @@index([ownerUserId])
  @@index([actorId])
}

/// A request to print an already-created Sale's receipt on a field agent's printer, sent by an
/// admin (owner or a permitted ManagedUser) from anywhere. See PrintJobEvent for the full
/// status-transition audit trail.
model PrintJob {
  id                  String          @id @default(uuid())
  userId              String          // business scope (getOwnerUserId)
  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Receipt jobs require a sale; kitchen KOT jobs use kotOrderId instead.
  saleId              String?
  sale                Sale?           @relation(fields: [saleId], references: [id], onDelete: Cascade)

  jobType             String          @default("receipt") // 'receipt' | 'kot'
  kotOrderId          String?

  // Plain string ids, not a Prisma relation, matching Sale.locationId's existing convention —
  // either side can be a User (owner) or ManagedUser (agent/staff) id, which Prisma can't express
  // as a single FK. Names are snapshotted at creation for stable history.
  requestedById       String
  requestedByName     String

  targetAgentId       String?
  targetAgentName     String?
  targetLocationId    String?
  targetLocationName  String?

  paperWidth          String          @default("58mm") // '58mm' | '80mm' — matches PrinterService's paperWidth type
  copies              Int             @default(1)

  // 'queued' | 'delivered' | 'accepted' | 'rejected' | 'printer_connect_pending' | 'printing'
  // | 'completed' | 'failed' | 'expired' | 'cancelled'
  status              String          @default("queued")
  failureReason       String?

  // Which specific agent actually accepted — relevant when targetLocationId was used instead of
  // a specific targetAgentId (first-accept-wins across everyone at that location).
  acceptedByAgentId   String?
  acceptedByAgentName String?

  expiresAt           DateTime        // createdAt + response window; checked lazily at read time, not a background timer (see Step 6 reasoning: PM2 cluster mode would run a setInterval on every worker redundantly)
  respondedAt         DateTime?
  completedAt         DateTime?

  events              PrintJobEvent[]

  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([targetAgentId, status])
  @@index([targetLocationId, status])
  @@index([saleId])
}

/// Full audit history of a PrintJob's status transitions — a real child table rather than a JSON
/// blob on PrintJob, matching how StockHistory/CreditTransaction already record change history
/// elsewhere in this schema, and so it stays queryable/exportable for the audit trail Step 7 asks for.
model PrintJobEvent {
  id         String   @id @default(uuid())
  printJobId String
  printJob   PrintJob @relation(fields: [printJobId], references: [id], onDelete: Cascade)
  status     String
  note       String?
  createdAt  DateTime @default(now())

  @@index([printJobId])
}

model KOTPrintEvent {
  id            String   @id @default(uuid())
  orderId       String
  order         KOTOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  batchNumber   Int
  kind          String   @default("kot") // kot | cancel
  itemSnapshot  Json
  printedByName String?
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@index([orderId])
  @@index([userId])
}
