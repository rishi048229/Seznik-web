generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String  @id @default(uuid())
  uid                 String  @unique // For migrating from firebase if needed
  email               String? @unique
  emailVerified       Boolean @default(false)
  phone               String? // nullable for pre-existing rows; required at registration
  password            String?
  displayName         String?
  photoURL            String? @db.Text
  businessName        String?
  businessType        String? // restaurant_cafe | online_store | retail_shop
  plan                String  @default("free")
  onboardingCompleted Boolean @default(false)
  role                String?
  permissions         Json?

  isBanned  Boolean   @default(false)
  banReason String?
  bannedAt  DateTime?
  seznikUser Boolean  @default(false)

  // Relations for managed users (if needed in backend, otherwise stored as JSON)
  // To keep it 1:1 with Firestore subcollections, we can create a separate ManagedUser model
  managedUsers          ManagedUser[]
  categories            Category[]
  settings              Settings?
  customers             Customer[]
  suppliers             Supplier[]
  products              Product[]
  stockHistory          StockHistory[]
  sales                 Sale[]
  purchases             Purchase[]
  expenses              Expense[]
  creditTransactions    CreditTransaction[]
  feedbacks             Feedback[]
  tokenTypes            TokenType[]
  tokens                Token[]
  creditReminders       CreditReminder[]
  dayCloses             DayClose[]
  restaurantTables      RestaurantTable[]
  kotOrders             KOTOrder[]
  kotOrderItems         KOTOrderItem[]
  locations             Location[]
  productLocationStocks ProductLocationStock[]
  stockTransfers        StockTransfer[]
  utilityBills          UtilityBill[]
  printerLogs           PrinterLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One pending email-verification OTP per email address (pre-signup).
model EmailOtp {
  id         String    @id @default(uuid())
  email      String    @unique
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

// Short-lived, one-time code shown as a QR on the web dashboard so the
// mobile app can sign in as the same account without typing a password.
// userId is not a FK: it may point at User or ManagedUser (see accountType).
model QrLoginSession {
  id          String    @id @default(uuid())
  tokenHash   String    @unique
  userId      String
  accountType String
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model ManagedUser {
  id           String  @id @default(uuid())
  uid          String  @unique
  displayName  String?
  email        String?
  password     String?
  role         String?
  permissions  Json?
  photoURL     String?
  businessName String?
  plan         String  @default("free")

  adminId String
  admin   User   @relation(fields: [adminId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id        String     @id @default(uuid())
  name      String
  isActive  Boolean    @default(true)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  products  Product[]
  // Self-relation for a single level of subcategories (e.g. "Shirts" -> "Checks", "Plain").
  // parent is nullable: null means this is a top-level category. Deleting a parent cascades
  // to its subcategories (a subcategory can't meaningfully outlive its parent).
  parentId  String?
  parent    Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children  Category[] @relation("CategoryHierarchy")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([parentId])
}

model Settings {
  id                 String   @id @default(uuid())
  businessName       String?
  businessAddress    String?
  businessPhone      String?
  businessGSTIN      String?
  businessLogoURL    String?  @db.Text
  personalInfo       Json?
  invoiceConfig      Json?
  notificationConfig Json?
  receiptConfig      Json?
  printerConfig      Json?
  locationConfig     Json?
  kotConfig          Json?
  // Merchant UPI VPA (e.g. shop@okhdfcbank). Required when a receipt QR is UPI.
  upiId              String?
  labelConfig        Json?
  /// When false (restaurants/cafes), inventory quantity is not tracked — only Product.isAvailable.
  trackStock         Boolean  @default(true)
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Customer {
  id                 String              @id @default(uuid())
  name               String
  phone              String
  email              String?
  address            String?
  creditBalance      Float               @default(0)
  creditLimit        Float               @default(0)
  // Pre-existing column not previously tracked in this file (restored from live DB
  // introspection so `db push` stays additive-only and never proposes dropping real data).
  oldestUnpaidSince  DateTime?
  userId             String
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  sales              Sale[]
  creditTransactions CreditTransaction[]
  creditReminders    CreditReminder[]
  kotOrders          KOTOrder[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([userId])
  @@index([userId, creditBalance])
}

model Supplier {
  id        String     @id @default(uuid())
  name      String
  phone     String
  email     String?
  address   String?
  gstin     String?
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  products  Product[]
  purchases Purchase[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Product {
  id                String    @id @default(uuid())
  name              String
  sku               String
  barcode           String?
  // Which symbology the barcode uses (CODE128 / EAN13 / QR) so label printing
  // renders it correctly for this specific product.
  barcodeType       String    @default("CODE128")
  categoryId        String
  category          Category  @relation(fields: [categoryId], references: [id])
  supplierId        String?
  supplier          Supplier? @relation(fields: [supplierId], references: [id])
  imageURL          String?   @db.Text
  costPrice         Float     @default(0)
  sellingPrice      Float     @default(0)
  taxRate           Float     @default(0)
  priceIncludesGst  Boolean   @default(false)
  currentStock      Float     @default(0)
  lowStockThreshold Float     @default(0)
  unit              String    @default("piece")
  /// Soft-delete / catalog membership. Soft-deleted products stay out of all catalogs.
  isActive          Boolean   @default(true)
  /// Menu availability (restaurants/cafes). Independent of stock quantity and soft-delete.
  isAvailable       Boolean   @default(true)

  brand       String?
  description String?   @db.Text
  expiryDate  DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  stockHistory   StockHistory[]
  kotOrderItems  KOTOrderItem[]
  locationStocks ProductLocationStock[]
  stockTransfers StockTransfer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, isActive])
  @@index([userId, isAvailable])
  @@index([userId, createdAt(sort: Desc)])
}

model StockHistory {
  id         String    @id @default(uuid())
  change     Float
  reason     String
  barcode    String?
  productId  String
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Set only when the change happened against a specific location's stock
  // pool (multi-location inventory) rather than the product's flat total.
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([productId, createdAt])
}

model Sale {
  id             String    @id @default(uuid())
  invoiceNumber  String
  customerId     String?
  customer       Customer? @relation(fields: [customerId], references: [id])
  items          Json
  subtotal       Float
  totalDiscount  Float
  totalTax       Float
  grandTotal     Float
  /** Restaurant / bill add-ons applied at checkout — [{ presetId, label, kind, type, value, amount }] */
  billCharges       Json?
  extraChargesTotal Float     @default(0)
  paymentMethod  String
  amountPaid     Float
  changeReturned Float
  isQuickBill    Boolean   @default(false)
  // Which location this whole sale was billed from (multi-location inventory
  // feature) — null when the feature is off or the location wasn't selected.
  locationId     String?
  platform       String    @default("web")
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token          Token?
  kotOrder       KOTOrder?
  createdAt      DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([userId, customerId])
}

// A physical place stock can sit — a warehouse, a shop branch, etc. Purely
// opt-in: Settings.locationConfig.enabled gates whether any of this is shown
// in the UI. A product with no matching ProductLocationStock row at the
// selected location is treated as 0 available there (not falling back to
// Product.currentStock) — that's what makes stock genuinely per-location.
model Location {
  id           String                 @id @default(uuid())
  name         String
  isActive     Boolean                @default(true)
  sortOrder    Int                    @default(0)
  userId       String
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  stocks       ProductLocationStock[]
  stockHistory StockHistory[]
  transfersOut StockTransfer[]        @relation("TransferFrom")
  transfersIn  StockTransfer[]        @relation("TransferTo")
  kotOrders    KOTOrder[]
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
}

// One row per (product, location): that location's stock count and an
// optional price override (null = use Product.sellingPrice). This is the
// join table that makes "sell from Warehouse vs Shop" mean something.
model ProductLocationStock {
  id                String   @id @default(uuid())
  productId         String
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  locationId        String
  location          Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  stock             Float    @default(0)
  priceOverride     Float?
  lowStockThreshold Float?
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([productId, locationId])
}

// A manual stock move between two locations for the same product.
model StockTransfer {
  id             String   @id @default(uuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  fromLocationId String
  fromLocation   Location @relation("TransferFrom", fields: [fromLocationId], references: [id])
  toLocationId   String
  toLocation     Location @relation("TransferTo", fields: [toLocationId], references: [id])
  quantity       Float
  note           String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
}

model Purchase {
  id            String    @id @default(uuid())
  invoiceNumber String
  supplierId    String?
  supplier      Supplier? @relation(fields: [supplierId], references: [id])
  items         Json
  subtotal      Float
  totalTax      Float
  grandTotal    Float
  paymentMethod String
  amountPaid    Float
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())

  @@index([userId, createdAt])
}

model Expense {
  id              String   @id @default(uuid())
  amount          Float
  category        String
  description     String?
  paymentMethod   String   @default("cash")
  receiptImageURL String?  @db.Text
  expenseDate     DateTime
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())

  @@index([userId, expenseDate])
}

model CreditTransaction {
  id          String   @id @default(uuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  amount      Float
  type        String
  referenceId String?
  notes       String?
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([customerId, createdAt])
}

model Feedback {
  id          String   @id @default(uuid())
  // What part of the app the feedback is about (e.g. "pos", "products", "general").
  area        String   @default("general")
  // 1-5 star rating; optional so pure text feedback is also valid.
  rating      Int?
  message     String
  platform    String   @default("unknown") // web | mobile | unknown (legacy)
  productId   String   @default("general")
  productName String   @default("Unknown")
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([productId])
}

// Pre-existing model not previously tracked in this file (restored from live DB
// introspection — no current backend route writes to it; `getRemindersDue`/`logReminderSent`
// in creditController.ts compute reminders in-memory rather than persisting here, so this
// table is effectively dormant, but it holds real historical rows and is left untouched).
model CreditReminder {
  id         String   @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  amount     Float
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sentAt     DateTime @default(now())
}

// Pre-existing model not previously tracked in this file (restored from live DB
// introspection). The frontend Daybook screen (mobile-inventory/src/app/credits.tsx) calls
// GET/POST /api/reports/day-close for this, but no such route exists in reportRoutes.ts today
// — that's a separate, pre-existing bug outside this change's scope, not something fixed here.
model DayClose {
  id           String   @id @default(uuid())
  closeDate    DateTime @db.Date
  expectedCash Float
  countedCash  Float
  variance     Float
  notes        String?
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@unique([userId, closeDate])
}

// A user-defined quick-bill item (e.g. "Chai Token", "Samosa Token", "Parking").
// price is nullable — a fixed-price type issues instantly, a null-price type
// (parking, QR bill) prompts for the amount at issue time.
model TokenType {
  id        String   @id @default(uuid())
  name      String
  price     Float?
  taxRate   Float    @default(0)
  // Keys into a fixed frontend icon/color palette (e.g. "coffee" / "amber") — not free text.
  icon      String   @default("ticket")
  color     String   @default("blue")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokens    Token[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Wraps an issued token's Sale record with a per-day sequential ticket number
// (resets daily) so the printed slip reads "Token #14" instead of an invoice number.
model Token {
  id          String     @id @default(uuid())
  tokenNumber Int
  note        String?
  tokenTypeId String?
  tokenType   TokenType? @relation(fields: [tokenTypeId], references: [id], onDelete: SetNull)
  saleId      String     @unique
  sale        Sale       @relation(fields: [saleId], references: [id], onDelete: Cascade)
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
}

// ─── KOT & Restaurant Orders (Phase 1) ─────────────────────────────────────

// Flat list of dine-in tables for Phase 1. Deliberately has no position/shape/
// capacity columns yet — a future floor-plan UI can add those as additive
// nullable columns via `npx prisma db push` with zero impact on existing rows
// or on KOTOrder, since it only references this model's id.
model RestaurantTable {
  id        String     @id @default(uuid())
  name      String
  capacity  Int?
  isActive  Boolean    @default(true)
  sortOrder Int        @default(0)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders    KOTOrder[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

// A dine-in/takeaway/delivery order moving through the kitchen. Items are a
// live child relation (not a JSON blob like Sale.items) so they can be added
// or removed while the order is still open — totals are computed on read and
// only crystallized into a real Sale's columns once the bill is generated.
model KOTOrder {
  id              String           @id @default(uuid())
  // Per-day sequential ticket number, resets daily. Mirrors Token.tokenNumber.
  orderNumber     Int
  orderType       String           @default("dine_in") // 'dine_in' | 'takeaway' | 'delivery'
  tableId         String?
  // SetNull, not Cascade: deleting/deactivating a table config must never destroy order history.
  table           RestaurantTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  // Free-text identifier for takeaway/delivery orders, or a supplemental note alongside a table.
  partyLabel      String?
  guestCount      Int?
  customerId      String?
  customer        Customer?        @relation(fields: [customerId], references: [id])
  // open -> sent_to_kitchen -> preparing -> ready -> served -> billed, or cancelled from any
  // non-terminal state. 'billed' is only ever set by the /bill endpoint, never generic status updates.
  status          String           @default("open")
  notes           String?
  // 'normal' | 'urgent' — surfaced on the orders board and printed as a banner on the KOT ticket.
  priority        String           @default("normal")
  // Phone number for takeaway/delivery orders — separate from an attached Customer record,
  // which stays optional (most takeaway/delivery orders never need a full customer profile).
  contactNumber   String?
  waiterName      String?
  locationId      String?
  location        Location?        @relation(fields: [locationId], references: [id], onDelete: SetNull)
  sentToKitchenAt DateTime?
  // Set once billed. SetNull (not Cascade): the order predates and outlives the sale it produces.
  saleId          String?          @unique
  sale            Sale?            @relation(fields: [saleId], references: [id], onDelete: SetNull)
  items           KOTOrderItem[]
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([userId, status])
  @@index([tableId])
}

model KOTOrderItem {
  id          String   @id @default(uuid())
  orderId     String
  order       KOTOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  // SetNull + productName snapshot: order history survives product deletion, same reasoning as
  // Sale.items JSON already snapshotting productName instead of always joining the live row.
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  quantity    Float
  unitPrice   Float // snapshot of Product.sellingPrice at add-time
  taxRate     Float // snapshot of Product.taxRate at add-time
  notes       String? // free-text note, e.g. "extra crispy please"
  // Quick-pick add-on/modifier tags, e.g. ["No Onion", "Extra Spicy"] — separate from the
  // free-text notes field above so the kitchen ticket can print them as a distinct tag list.
  modifiers   String[] @default([])
  status      String   @default("pending")
  sentToKitchenAt DateTime?
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orderId])
}

/// Admin-generated unique alphanumeric access codes (7 chars) for distribution / redemption.
model AccessCode {
  id             String    @id @default(uuid())
  code           String    @unique @db.VarChar(7)
  batchId        String
  note           String?
  createdBy      String?
  createdAt      DateTime  @default(now())
  customerName   String?
  customerId     String?
  invoiceNumber  String?
  phone          String?
  printer        String?
  isUsed         Boolean   @default(false)
  usedAt         DateTime?
  usedByUserId   String?
  customerEmail  String?

  @@index([batchId])
  @@index([createdAt])
  @@index([createdBy])
  @@index([isUsed])
  @@index([usedByUserId])
  @@index([invoiceNumber])
}

/// Customer-support portal agents managed from the admin Support Access page.
model SupportAgent {
  id           String    @id @default(uuid())
  name         String
  phone        String
  email        String    @unique
  username     String    @unique
  passwordHash String
  isDisabled   Boolean   @default(false)
  createdBy    String?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([isDisabled])
}

/// Hourly aggregated API usage for admin analytics (feature × route × method × businessType).
model ApiUsageBucket {
  id           String   @id @default(uuid())
  bucketStart  DateTime // floored to hour UTC
  featureKey   String
  routePrefix  String
  method       String
  businessType String // restaurant_cafe | online_store | retail_shop | unknown
  callCount    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([bucketStart, featureKey, routePrefix, method, businessType])
  @@index([bucketStart])
  @@index([businessType, bucketStart])
  @@index([featureKey, bucketStart])
}

/// Utility bills converted to thermal payment receipts (A4 to Receipt feature).
model UtilityBill {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  receiptNumber  String?
  kioskName      String?  @default("SEZNIK KIOSK")
  billType       String   @default("Electricity") // Electricity | Water | Gas | Telecom | Other
  provider       String?
  consumerNumber String?
  consumerName   String?
  dueDate        String?
  billDate       String?
  unitsConsumed  String?
  billAmount     Float    @default(0)
  convenienceFee Float    @default(0)
  totalAmount    Float    @default(0)
  totalReceived  Float    @default(0)
  status         String   @default("SUCCESS (PAID)")
  paymentMode    String?  @default("CASH")
  customerPhone  String?
  operatorName   String?
  date           DateTime @default(now())
  rawText        String?  @db.Text
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@index([userId, date])
  @@index([consumerNumber])
  @@index([receiptNumber])
}

/// Logs of printer connections (exact bluetooth device names) from Web and Mobile apps.
model PrinterLog {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  printerName    String   // Exact Bluetooth name as reported by the device
  deviceAddress  String?  // MAC address or Web BLE device UUID
  platform       String   @default("web") // 'web' | 'mobile'
  connectionType String?  @default("bluetooth") // 'bluetooth' | 'ble'
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([printerName])
  @@index([createdAt])
  @@index([platform])
}

