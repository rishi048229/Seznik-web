# Backend Server Port
PORT=5000

# Node Environment
NODE_ENV=production

# Database Connection (PostgreSQL)
# connection_limit/pool_timeout: each PM2 worker (see ecosystem.config.js) gets its own Prisma
# connection pool, so TOTAL connections = connection_limit * PM2 instance count. Size it as
# (Postgres max_connections * 0.8) / instance count, leaving ~20% headroom for migrations/admin
# tools/other services. 10 below assumes a modest box; re-tune for your real production instance
# count and `SHOW max_connections;` value. pool_timeout is how long (seconds) a query waits for a
# free connection before failing fast, rather than queuing forever.
DATABASE_URL="postgresql://username:password@localhost:5432/seznik_db?schema=public&sslmode=require&connection_limit=10&pool_timeout=20"

# JWT Token Secret Key
JWT_SECRET=your_super_secret_jwt_key_here

# Configured CORS Allowed Origins
CORS_ORIGIN=https://your-frontend-domain.com

# SMTP (email OTP verification). Works with Gmail app passwords, Brevo, SendGrid, etc.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com,
# SMTP_PASS=<16-char app password from https://myaccount.google.com/apppasswords>
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASS=your_smtp_password
SMTP_FROM="Seznik POS <no-reply@example.com>"
