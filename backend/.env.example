# Backend Server Port
PORT=5000

# Node Environment
NODE_ENV=production

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://username:password@localhost:5432/seznik_db?schema=public&sslmode=require"

# JWT Token Secret Key
JWT_SECRET=your_super_secret_jwt_key_here

# Configured CORS Allowed Origins
CORS_ORIGIN=https://your-frontend-domain.com

# SMTP (email OTP verification). Works with Gmail app passwords, Brevo, SendGrid, etc.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com,
# SMTP_PASS=<16-char app password from https://myaccount.google.com/apppasswords>
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASS=your_smtp_password
SMTP_FROM="Seznik POS <no-reply@example.com>"

# Google Gemini AI API Key (Get a free API key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

